# 复制为 .env 后填写自己的密钥；.env 已在 .gitignore 中，不会被提交
# ---------------------------------------------------------------
# Supabase（项目设置 → API 里找 Project URL 与 anon public key）
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# 正式上线可换成 service_role key（只在 Vercel 服务端使用，切勿写入前端）
# SUPABASE_SERVICE_ROLE_KEY=

# 豆包（火山方舟）—— 控制台的 API Key
DOUBAO_API_KEY=
# 方舟的推理接入点 ID（ep-xxxxxx）或模型名称
DOUBAO_MODEL=doubao-seed-1-6-250615

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 通义千问 DashScope（必须使用 compatible-mode 地址）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Kimi（月之暗面）
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
